# ==============================================================================
# ZEWA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# Supabase Credentials (Provided in your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Google Maps API (For Geocoding, Places and Direct Directions Navigation)
GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Payment Gateway Configuration (To be configured with Razorpay / Stripe / UPI)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_KEY_ID=your_payment_gateway_key_id
PAYMENT_KEY_SECRET=your_payment_gateway_secret_key

# Security & Rules
MAX_ORDER_QUANTITY_PER_USER=2
RESERVATION_TIMEOUT_MINUTES=10
